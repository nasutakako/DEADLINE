rules_version = '2';
// DEADLINE world ranking. Paste into Firebase console → Firestore Database → ルール, then 公開.
// Everyone can read the ranking; each player (anonymous sign-in) writes only their own record,
// and a name belongs to whoever claimed it first.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function okGame(g) { return g in ['deadline1', 'deadline2', 'deadline3d']; }
    // the fixed boards, the all-time ones (at1-at4: 歴代ランキング, one per stage 3), and the weekly ranking's
    // (wk + the week's number, e.g. wk2964)
    function okBoard(b) { return b in ['players', 'loop', 'daily1', 'daily2', 'daily3', 'at1', 'at2', 'at3', 'at4'] || b.matches('wk[0-9]{1,6}'); }

    // games/<game>/<board>/<uid>: { name, key, best, at, title } — players is stage 3, loop DEADLINE1's 無限回路, daily1-3 the daily nights, wk<n> the weekly ranking, at1-at4 the all-time ones
    match /games/{game}/{board}/{uid} {
      allow read: if okGame(game) && okBoard(board);
      allow create, update: if okGame(game) && okBoard(board) && signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'key', 'best', 'at', 'title'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.key is string && request.resource.data.key.size() <= 200
        && (!('best' in request.resource.data)
            || (request.resource.data.best is number && request.resource.data.best >= 0 && request.resource.data.best <= 86400))
        && (!('at' in request.resource.data) || request.resource.data.at is string)
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 20))
        // the name on the record must be one this player owns
        && get(/databases/$(database)/documents/games/$(game)/names/$(request.resource.data.key)).data.owner == request.auth.uid;
      // a player can take their own record off (the name and ranking deletion in the game)
      allow delete: if okGame(game) && okBoard(board) && signedIn() && request.auth.uid == uid;
    }

    // games/<game>/names/<key>: { owner, name } — one owner per name
    match /games/{game}/names/{key} {
      allow read: if okGame(game);
      allow create: if okGame(game) && signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'name'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow update: if okGame(game) && signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'name'])
        && request.resource.data.owner == request.auth.uid;
      allow delete: if okGame(game) && signedIn() && resource.data.owner == request.auth.uid;
    }

    // games/<game>/refs/<uid>: { by, at } — a new player who came by a friend's LINE invitation, written once by
    // that new player; the friend who sent it reads the ones naming them (★5 each in the game)
    match /games/{game}/refs/{uid} {
      allow create: if okGame(game) && signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by is string && request.resource.data.by.size() >= 1 && request.resource.data.by.size() <= 128
        && request.resource.data.by != uid
        && request.resource.data.at is string;
      allow read: if okGame(game) && signedIn() && resource.data.by == request.auth.uid;
    }

    // games/<game>/data/users/<uid>/...: each player's own high scores, private
    match /games/{game}/data/users/{uid}/{doc} {
      allow read, write: if okGame(game) && signedIn() && request.auth.uid == uid;
    }
  }
}
